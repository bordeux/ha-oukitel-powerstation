# Copy to .env and fill in your values. .env is gitignored — never commit real secrets.
# Used only by the dev/RE helper scripts in tools/ (not by the Home Assistant integration).

# Quectel / WonderFree cloud account (for tools/quectel_cloud.py + tools/cloud_temp_check.py)
QUECTEL_EMAIL=you@example.com
QUECTEL_PASSWORD=your-password

# Your device (deviceKey = its WiFi MAC, lowercase no separators; productKey is the model)
OUKITEL_DK=aabbccddeeff
OUKITEL_PK=p11wN7

# Per-device AES key from the cloud (tools/quectel_cloud.py prints it) — for tools/oukitel_local.py
OUKITEL_AUTHKEY=base64-authkey==

# Station LAN IP (optional; oukitel_local.py also accepts it as argv[1])
OUKITEL_HOST=192.168.1.50
